{
  "manifest_version": 3,
  "name": "LinkedIn Outreach AI",
  "version": "6.0.0",
  "description": "Outreach coach for skilled migrants: personalised, format-safe LinkedIn messages tuned for the Australian job market.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Outreach AI"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/linkedin-text.js"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ]
}